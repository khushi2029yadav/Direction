# -----------------------------------------------------------------------------
# DISHA CLASSES — ENVIRONMENT CONFIGURATION TEMPLATE
# -----------------------------------------------------------------------------
# Copy this file to .env.local for local development.
# In Vercel, configure these under Settings > Environment Variables.
# All variables are optional; resilient offline/local fallbacks are built in.
# -----------------------------------------------------------------------------

# Production Canonical Site URL (Used for metadata & OpenGraph)
NEXT_PUBLIC_SITE_URL=https://dishaclasses.in

# Supabase (Optional — for cloud persistence of student admission enquiries)
# If omitted, enquiries seamlessly fall back to local storage persistence with admin access.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Direct WhatsApp & Contact Configuration (Defaults to Disha Classes official line)
NEXT_PUBLIC_WHATSAPP_NUMBER=919224657102
NEXT_PUBLIC_INSTITUTE_PHONE=+919224657102
